name = "clip"
files = {
	["README.md"] = "clip/README.md",
	["clip.lua"] = "clip/clip.lua",
	["copy.lua"] = "clip/copy.lua",
	["ffi.lua"] = "clip/ffi.lua",
	["paste.lua"] = "clip/paste.lua",
	["pasteimage.lua"] = "clip/pasteimage.lua",
	["sdl.lua"] = "clip/sdl.lua",
	["test.lua"] = "clip/test.lua",
	["test_sdl.lua"] = "clip/test_sdl.lua",
}

deps = {
	"ext",
	"ffi",
	"image",
}

-- Put this in distinfo so that dependency-traversal can be used to substitute #include's with ffi.req's.
-- I could put it in its own file so that distinfo autogen doesn't delete it, meh...
generateBindings = {
	inc = '<cclip.h>',
	out = 'ffi.lua',	-- replace any `#include <cclip.h>`'s with `]] require 'clip.ffi' ffi.cdef[[` ...
	final = function(code)
		code = code .. '\n'
			.."return require 'ffi.load' 'clip'\n"	-- clip.dll, libclip.so, libclip.dylib
		return code
	end,
}
